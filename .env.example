POSTGRES_DB=finance_auditor
POSTGRES_USER=finance_admin
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_ADMIN_SECRET
APP_DB_PASSWORD=REPLACE_WITH_RANDOM_APP_SECRET
DATABASE_URL=postgresql+psycopg://finance_app:REPLACE_WITH_RANDOM_APP_SECRET@localhost:5432/finance_auditor
API_KEY=REPLACE_WITH_RANDOM_API_SECRET_AT_LEAST_32_CHARACTERS
OLLAMA_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=nomic-embed-text:latest
PAPER_PORTFOLIO_ID=1
MAX_TRADE_QUOTE_AGE_SECONDS=1200

# Phase 3 defaults keep model requests on loopback. Set a local tool-capable model.
AGENT_LLM_BASE_URL=http://127.0.0.1:11434/v1
AGENT_MODEL=
AGENT_LLM_API_KEY=local-only
AGENT_ALLOW_REMOTE_LLM=false
AGENT_MODEL_TIMEOUT_SECONDS=60
AGENT_MAX_STEPS=8
AGENT_MAX_TOOL_CALLS=16
AGENT_MAX_OUTPUT_TOKENS=2000
AGENT_MAX_CONTEXT_CHARS=100000
AGENT_LOCAL_JSON_MODE=true
